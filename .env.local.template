# ============================================
# DandoLink ローカル開発 .env.local テンプレート
# ============================================
# 使い方: このファイルをコピーして .env.local にリネームし、
#         Vercel ダッシュボード (Project → Settings → Environment Variables)
#         から値をコピーして貼り付けてください。
# ============================================

# ---- Database (Supabase Postgres) ----
# Vercel: DATABASE_URL
DATABASE_URL=
# Prisma migration / introspection 用 (通常 DATABASE_URL と同じでよい)
DIRECT_URL=

# ---- Supabase ----
# Vercel: NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_URL=
# Vercel: NEXT_PUBLIC_SUPABASE_ANON_KEY (公開キー)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Vercel: SUPABASE_SERVICE_ROLE_KEY (サーバ専用、絶対公開禁止)
SUPABASE_SERVICE_ROLE_KEY=

# ---- NextAuth ----
# ローカルは固定で OK
NEXTAUTH_URL=http://localhost:3001
# Vercel: NEXTAUTH_SECRET (本番と同じ値でも良いが、別値推奨)
# 生成: openssl rand -base64 32
NEXTAUTH_SECRET=

# ---- Google Maps ----
# Vercel: NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Vercel: NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID (任意)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---- Upstash Redis (rate limit) ----
# 未設定でもアプリ動作可 (rate limit が無効化される)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Web Push (VAPID) ----
# Vercel から取得。プッシュ通知を試さないなら空で可
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- ブランディング (任意) ----
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_TAGLINE=
NEXT_PUBLIC_APP_LOGO=

# ---- 初期管理者作成スクリプト用 (任意) ----
INIT_ADMIN_EMAIL=
INIT_DB_SECRET=

# ---- Sentry (ビルド時のみ。ローカル dev では不要) ----
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=
