// 改ざん防止トリガ（confirmed の amount/projectId/customerId UPDATE 拒否）は
// 生成された migration.sql に手動追記する（§14.3 参照）。
// ============================================================================

enum BillingDraftStatus {
  pending
  confirmed
  cancelled

  @@schema("public")
}

model BillingDraft {
  id          String             @id @default(uuid())
  projectId   String
  customerId  String
  title       String
  amount      Decimal?           @db.Decimal(12, 2)
  taxRate     Decimal            @default(0.10) @db.Decimal(5, 4)
  status      BillingDraftStatus @default(pending)
  invoiceId   String?
  createdById String
  note        String?
  // InvoiceItem[] を JSON 文字列で保存（複数明細セクション化）。null = 旧・単一行モデル（amount/title を使用・後方互換）
  items       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  projectMaster ProjectMaster @relation(fields: [projectId], references: [id], onDelete: Restrict)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy     User          @relation(fields: [createdById], references: [id])

  @@index([projectId, status])
  @@index([customerId, status])
  @@index([invoiceId])
  @@index([deletedAt])
  @@schema("public")
}

/// @deprecated 2026-06-02: 原価の手修正は案件単位（MonthlyProjectCostOverride）へ移行。本テーブルは未使用（将来 DROP 可）。
/// 利益ダッシュボードの月次・案件担当者別「原価」の手修正（上書き）値。
/// assigneeId は User.id。担当者未設定ぶんは '__unassigned__' センチネルを使う（FK は張らない）。
model MonthlyAssigneeCostOverride {
  id         String   @id @default(uuid())
  year       Int
  month      Int      // 1-12（JST）
  assigneeId String
  cost       Decimal  @db.Decimal(12, 2)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([year, month, assigneeId])
  @@index([year, month])
  @@schema("public")
}

/// 利益ダッシュボードの月次・案件別「原価」の手修正（上書き）値。
/// 既定は日報・配置から自動算出（人件費＋車両費）し、行が在ればその月・案件の原価を上書きする。
/// 担当者別の原価合計は、その担当者が主担当の案件の原価（自動 or 上書き）の積み上げ。
/// projectId は ProjectMaster.id（FK は張らない＝集計専用の軽量テーブル）。
model MonthlyProjectCostOverride {
  id         String   @id @default(uuid())
  year       Int
  month      Int      // 1-12（JST）
  projectId  String
  cost       Decimal  @db.Decimal(12, 2)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([year, month, projectId])
  @@index([year, month])
  @@schema("public")
}

/// 仕入請求書の費目マスタ。請求書由来の原価を、原価エンジンのどのバケットに集計するかを costBucket で決める。
/// 例: 材料費=material / リース費・燃料費・重機リース=other / 積込費=loading
model ExpenseCategory {
  id         String   @id @default(uuid())
  name       String // 材料費 / リース費 / 燃料費 / 重機リース 等
  costBucket String   @default("other") // 'material' | 'other' | 'loading'（原価エンジンの集計先）
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchaseInvoices   PurchaseInvoice[]
  allocations        PurchaseInvoiceAllocation[]
  receipts           Receipt[]
  cashbookEntries    CashbookEntry[]
  cardReceipts       CardReceipt[]
  cardStatementLines CardStatementLine[]

  @@index([sortOrder])
  @@index([isActive])
  @@schema("public")
}

/// 【取込機能撤去 2026-07-03】仕入先などからの「支払側」請求書（買掛）。1枚=1レコード。
/// 取込UI・API（アップロード→AI抽出→仕分け→確定）は未使用のため削除済み。
/// ⚠️ 確定済みデータは現役＝原価エンジン(lib/projectCost.ts)が allocations を集計し
/// 案件原価・利益数字に反映し続ける。テーブル・データは削除しないこと。
model PurchaseInvoice {
  id     String @id @default(uuid())
  status String @default("pending") // 'pending'(未仕分け) | 'classified'(仕分け下書き) | 'confirmed'(確定)

  // ファイル（Supabase Storage。ProjectMasterFile と同じ持ち方）
  fileName                    String
  storagePath                 String
  thumbnailPath               String?
  mimeType                    String
  fileSize                    Int
  sourceType                  String? // 'pdf' など
  signedUrl                   String?
  signedUrlExpiresAt          DateTime?
  thumbnailSignedUrl          String?
  thumbnailSignedUrlExpiresAt DateTime?

  // AI抽出の生データ（支払先・日付・金額・品目・推定費目/案件ヒント）
  extractedData Json?

  // 仕分け確定値
  payeeName         String?
  payeeId           String?
  // AI抽出した支払先口座（確定時に振込先マスター(Payee)へ登録/再利用）
  payeeKana         String?
  bankName          String?
  branchName        String?
  accountType       String?
  accountNumber     String?
  accountHolder     String?
  issueDate         DateTime?
  dueDate           DateTime?
  totalAmount       Decimal?  @db.Decimal(12, 2)
  taxAmount         Decimal?  @db.Decimal(12, 2)
  projectMasterId   String?
  expenseCategoryId String?
  notes             String?

  // 連携・監査
  paymentScheduleId String? // 確定時に作成した支払予定への参照
  confirmedAt       DateTime?
  confirmedBy       String?
  uploadedBy        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  projectMaster   ProjectMaster?        @relation(fields: [projectMasterId], references: [id], onDelete: SetNull)
  expenseCategory ExpenseCategory?      @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  payee           Payee?                @relation(fields: [payeeId], references: [id], onDelete: SetNull)
  items           PurchaseInvoiceItem[]
  allocations     PurchaseInvoiceAllocation[]

  @@index([status])
  @@index([projectMasterId])
  @@index([payeeId])
  @@index([expenseCategoryId])
  @@index([createdAt])
  @@schema("public")
}

/// 仕入請求書の明細行（AI抽出の品目）。原価計算は PurchaseInvoice.totalAmount を使うため表示・確認用。
model PurchaseInvoiceItem {
  id                String   @id @default(uuid())
  purchaseInvoiceId String
  name              String
  quantity          Float?
  unit              String?
  unitPrice         Decimal? @db.Decimal(12, 2)
  amount            Decimal? @db.Decimal(12, 2)
  sortOrder         Int      @default(0)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@index([purchaseInvoiceId])
  @@schema("public")
}

/// 仕入請求書の案件配分行（1枚を複数案件へ按分計上するための行：案件×費目×金額）。
/// 原価エンジンは確定済み請求書のこの配分行を案件ごとに集計する。支払い自体は請求書1枚=1本のまま。
model PurchaseInvoiceAllocation {
  id                String   @id @default(uuid())
  purchaseInvoiceId String
  projectMasterId   String? // 案件削除時は SetNull（その案件分の原価計上は外れる）
  expenseCategoryId String? // 費目（原価バケット決定用）。配分行ごとに指定可
  amount            Decimal  @db.Decimal(12, 2) // この案件に配分する税込金額
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseInvoice PurchaseInvoice  @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  projectMaster   ProjectMaster?   @relation(fields: [projectMasterId], references: [id], onDelete: SetNull)
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  @@index([purchaseInvoiceId])
  @@index([projectMasterId])
  @@schema("public")
}

/// 領収書・レシート。アップロード→Claude APIで読み取り→費目を仕分けて確定する。
/// 仕入請求書(PurchaseInvoice)の簡易版: 支払済みの記録のため PaymentSchedule・Payee・原価エンジン集計は行わない。
/// 案件(projectMasterId)は参照・検索用の任意リンク（原価には計上しない）。
model Receipt {
  id     String @id @default(uuid())
  status String @default("pending") // 'pending'(未仕分け) | 'confirmed'(仕分け済み)

  // ファイル（PurchaseInvoice と同じ持ち方。Supabase Storage）
  fileName                    String
  storagePath                 String
  thumbnailPath               String?
  mimeType                    String
  fileSize                    Int
  sourceType                  String? // 'pdf' など
  signedUrl                   String?
  signedUrlExpiresAt          DateTime?
  thumbnailSignedUrl          String?
  thumbnailSignedUrlExpiresAt DateTime?

  // AI抽出の生データ（店名・日付・金額・税額・摘要・推定費目）
  extractedData Json?

  // 仕分け値
  storeName         String?
  issueDate         DateTime?
  totalAmount       Decimal?  @db.Decimal(12, 2)
  taxAmount         Decimal?  @db.Decimal(12, 2)
  expenseCategoryId String?
  projectMasterId   String?
  paymentMethod     String? // 'cash'(現金) | 'company_card'(会社カード) | 'personal'(個人立替)
  paidBy            String? // 支払者名（自由入力）
  notes             String?

  // 精算（立替者への支払い）状況。仕分け（費目分類）とは独立したフラグ。
  settled   Boolean   @default(false)
  settledAt DateTime?
  settledBy String?

  // 監査
  confirmedAt DateTime?
  confirmedBy String?
  uploadedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  projectMaster   ProjectMaster?   @relation(fields: [projectMasterId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([issueDate])
  @@index([expenseCategoryId])
  @@index([projectMasterId])
  @@index([createdAt])
  @@index([settled])
  @@schema("public")
}

/// 現金出納帳の行。閲覧・編集は User.canAccessCashbook を持つユーザーのみ（個別許可制）。
/// 入金('in')は手打ちのみ、出金('out')は手打ち＋領収書画像/PDFのAI読み取りで作成。
/// 差引残高は DB に持たず、表示時に (date asc, seq asc) 順の累計で計算する。
/// 既存の領収書(Receipt)・原価計算・利益計算とは完全に独立（連携しない）。
model CashbookEntry {
  id        String  @id @default(uuid())
  /// 登録順の通し番号。同日内の行順と残高計算の決定性を担保する（並びは date asc, seq asc で一意）
  seq       Int     @unique @default(autoincrement())
  /// 取引日（UTC 0時固定。Receipt.issueDate と同じ扱い）
  date      DateTime
  /// 'in'(入金・手打ちのみ) | 'out'(出金・手打ち or 領収書取込)
  entryType String
  /// 摘要（店名・内容など）
  description String?
  /// 金額（正の値のみ。入金/出金の向きは entryType で表す）
  amount            Decimal @db.Decimal(12, 2) @default(0)
  expenseCategoryId String?
  /// 清算日（実際に現金が動いた日・任意）。月別表示と残高計算は settledAt ?? date 基準
  settledAt     DateTime?
  /// 申請者（氏名・自由入力。Excel出納帳の「申請者」欄）
  applicantName String?
  /// 同一表示日内の手動並び順（上下移動で隣接行との中間値を設定。null は seq 順）
  sortOrder     Float?
  /// 精算方法。'cash'(現金) | 'transfer'(振込)。null=現金扱い。振込精算は現金残高の計算から除外する
  settleMethod  String?

  // 証憑ファイル（出金行の領収書。手打ち行は null。Receipt と同じ持ち方・Supabase Storage）
  fileName                    String?
  storagePath                 String?
  thumbnailPath               String?
  mimeType                    String?
  fileSize                    Int?
  sourceType                  String? // 'pdf' など
  signedUrl                   String?
  signedUrlExpiresAt          DateTime?
  thumbnailSignedUrl          String?
  thumbnailSignedUrlExpiresAt DateTime?

  // AI抽出の生データ（店名・日付・金額・税額・摘要・推定費目）
  extractedData Json?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([settledAt])
  @@index([expenseCategoryId])
  @@index([createdAt])
  @@schema("public")
}

/// クレジットカード利用レシートの受け箱。アップロード→Claude APIで読み取り→明細行(CardStatementLine)と照合する。
/// 領収書(Receipt)・現金出納帳・原価計算・利益計算とは完全に独立（連携しない）。閲覧・編集は User.canAccessCashbook 保持者のみ。
/// 紐付け状態は status 列を持たず、CardStatementLine.cardReceiptId からの1:1逆参照(statementLine)で導出する。
model CardReceipt {
  id        String  @id @default(uuid())
  /// カード名ラベル（例「AMEX 今井」）。アップロード時に任意指定
  cardLabel String?

  // ファイル（Receipt と同じ持ち方・Supabase Storage。prefix は card-receipts/）
  fileName                    String
  storagePath                 String
  thumbnailPath               String?
  mimeType                    String
  fileSize                    Int
  sourceType                  String? // 'pdf' など
  signedUrl                   String?
  signedUrlExpiresAt          DateTime?
  thumbnailSignedUrl          String?
  thumbnailSignedUrlExpiresAt DateTime?

  // AI抽出の生データ（店名・日付・金額・税額・摘要・推定費目）
  extractedData Json?

  // 抽出値（手修正可）
  storeName         String?
  /// 発行日（UTC 0時固定。Receipt.issueDate と同じ扱い）
  issueDate         DateTime?
  /// 金額の通貨コード（null=円）。例 'USD'。totalAmount/taxAmount はこの通貨の値のまま持つ（例 $29.39 → 29.39）
  currency          String?
  totalAmount       Decimal?  @db.Decimal(12, 2)
  taxAmount         Decimal?  @db.Decimal(12, 2)
  /// AI費目候補。明細行への紐付け時に行側へ引き継ぐ
  expenseCategoryId String?
  notes             String?
  /// 担当名（氏名・自由入力。既定はアップロードした人。CashbookEntry.applicantName と同じ扱い）
  applicantName     String?

  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  expenseCategory ExpenseCategory?   @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  statementLine   CardStatementLine?

  @@index([issueDate])
  @@index([totalAmount])
  @@index([createdAt])
  @@schema("public")
}

/// クレジットカード「ご利用代金明細書」。1PDF=1件。Claude APIで明細行を全行抽出し CardStatementLine を作成する。
/// 費目仕分けは会計用途のみで原価エンジン・Payee・支払予定には反映しない。明細書レベルの status は持たない（照合進捗は行の集計で表示）。
model CardStatement {
  id        String @id @default(uuid())
  /// カード名ラベル（例「AMEX 今井」）。アップロード時に必須入力
  cardLabel String

  // AI抽出ヘッダ（手修正可）
  memberName  String? // 会員氏名
  cardLast4   String? // 会員番号 下4桁
  /// 明細書作成日（締め日）。UTC 0時固定。明細行の年補完の基準
  closingDate DateTime?
  /// 「今月ご利用額合計」（検算用。行合計と不一致なら UI で警告）
  totalAmount Decimal?  @db.Decimal(12, 2)

  // ファイル（Receipt と同じ持ち方・Supabase Storage。prefix は card-statements/。PDF主体だが画像も許容）
  fileName                    String
  storagePath                 String
  thumbnailPath               String?
  mimeType                    String
  fileSize                    Int
  sourceType                  String? // 'pdf' など
  signedUrl                   String?
  signedUrlExpiresAt          DateTime?
  thumbnailSignedUrl          String?
  thumbnailSignedUrlExpiresAt DateTime?

  // AI抽出の生データ + 検算メタ（{ reportedTotal, computedTotal, lineCount }）
  extractedData Json?

  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines CardStatementLine[]

  @@index([cardLabel])
  @@index([closingDate])
  @@index([createdAt])
  @@schema("public")
}

/// 明細書の1行。status: 'unmatched'(未照合) | 'matched'(照合済み・cardReceiptId 必須) | 'no_receipt'(レシート不要=サブスク等)。
/// cardReceiptId の @unique が同一レシートの二重紐付けをDBレベルで防ぐ。明細書削除は Cascade で行ごと消え、レシートは自動的に未紐付けへ戻る。
model CardStatementLine {
  id          String @id @default(uuid())
  statementId String
  status      String @default("unmatched")
  /// PDF上の行順
  sortOrder   Int    @default(0)

  /// 利用日（明細書の「5月15日」形式を締め日基準で年補完済み・UTC 0時固定）
  useDate       DateTime
  storeName     String
  storeCategory String? // 店舗カテゴリ（旅行代理店/専門店 等）
  /// 海外利用時の外貨金額（国内利用は null）
  foreignAmount Decimal? @db.Decimal(14, 2)
  currency      String? // 通貨（USD 等）
  exchangeRate  Decimal? @db.Decimal(12, 4)
  /// 円金額。返金・キャンセル行はマイナス
  amount        Decimal  @db.Decimal(12, 2)
  /// 商品明細サブ行（数量/金額/商品名）を1行にまとめた表示用テキスト
  itemDetails   String?

  /// 費目仕分け（会計用途のみ・原価には計上しない）
  expenseCategoryId String?
  notes             String?

  /// 照合済みレシート（1:1）
  cardReceiptId String?   @unique
  matchedAt     DateTime?
  matchedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statement       CardStatement    @relation(fields: [statementId], references: [id], onDelete: Cascade)
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  cardReceipt     CardReceipt?     @relation(fields: [cardReceiptId], references: [id], onDelete: SetNull)

  @@index([statementId])
  @@index([status])
  @@index([expenseCategoryId])
  @@schema("public")
}
