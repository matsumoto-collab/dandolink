  transportCost      Decimal?         @db.Decimal(12, 2)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  projectMaster      ProjectMaster    @relation(fields: [projectMasterId], references: [id], onDelete: Cascade)
  constructionType   ConstructionType @relation(fields: [constructionTypeId], references: [id], onDelete: Restrict)

  @@unique([projectMasterId, constructionTypeId], map: "ProjectMasterSubcontractorCost_projectMasterId_constructionType")
  @@index([projectMasterId])
  @@index([constructionTypeId])
  @@schema("public")
}

model PartnerWorkVolume {
  id                  String    @id @default(uuid())
  partnerCompanyId    String
  date                DateTime  @db.Date
  customerName        String?
  projectMasterId     String?
  projectTitle        String
  managerName         String?
  constructionContent String?
  amount              Int       @default(0)
  sourceAssignmentId  String?
  rowType             String    @default("work")
  isManual            Boolean   @default(false)
  sortOrder           Int       @default(0)
  notes               String?
  status              String    @default("draft")
  completedAt         DateTime?
  completedBy         String?
  // 論理削除。自動行（sourceAssignmentId 由来）を「以降再表示しない」状態にするための墓標。
  // deletedAt != null の行は GET の rows から除外される一方、usedAutoKeys に登録されるため
  // 同じ (assignmentId, rowType) の auto 行が再生成されない。
  deletedAt           DateTime?
  deletedBy           String?
  // amount をユーザーが明示的に設定したか。true のとき GET の amount=0 自動再算出をスキップする。
  // 既存挙動を壊さないため default=false（amount=0 のまま「完了」されただけのケースは従来通り
  // 案件マスタの協力業者費から再算出される）。
  amountOverridden    Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  updatedBy           String?

  @@unique([sourceAssignmentId, rowType])
  @@index([partnerCompanyId, date])
  @@index([date])
  @@index([partnerCompanyId, status])
  @@index([partnerCompanyId, date, deletedAt])
  @@schema("public")
}

/// 協力業者出来高の月単位の「協力業者への公開」状態（2026-06-10 公開ボタン化で利用開始）。
/// status: 'published' = 公開済み / 'draft' = 未公開。
/// completedAt / completedBy は公開日時 / 公開操作者として転用（列名は完了由来だが
/// マイグレーション回避のため列追加せず流用）。
/// 協力業者の閲覧は「全行完了 && status='published'」の AND（GET /api/partner-work-volume）。
model PartnerWorkVolumeMonth {
  id               String    @id @default(uuid())
  partnerCompanyId String
  year             Int
  month            Int
  status           String    @default("draft")
  completedAt      DateTime?
  completedBy      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([partnerCompanyId, year, month])
  @@index([partnerCompanyId])
  @@schema("public")
}

