generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

model User {
  id                      String   @id @default(cuid())
  username                String   @unique
  email                   String   @unique
  displayName             String
  passwordHash            String
  role                    String   @default("manager")
  assignedProjects        String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  teamId                  String?
  dailyRate               Decimal? @db.Decimal(10, 2)
  dispatchSortOrder       Int?
  hideByDefaultInDispatch Boolean  @default(false)
  companyId               String?
  isLoginEnabled          Boolean  @default(true)
  failedLoginCount        Int      @default(0)
  lockedUntil             DateTime?
  company                 User?    @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: SetNull)
  members                 User[]   @relation("CompanyMembers")

  @@index([username])
  @@index([email])
  @@index([teamId])
  @@index([role])
  @@index([companyId])
  @@schema("public")
}

model ProjectMaster {
  id                         String                           @id @default(uuid())
  title                      String
  constructionType           String                           @default("other")
  status                     String                           @default("active")
  location                   String?
  description                String?
  remarks                    String?
  createdBy                  String?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  updatedBy                  String?
  area                       Float?
  areaRemarks                String?
  city                       String?
  constructionContent        String?
  contractAmount             Int?
  customerId                 String?
  customerName               String?
  estimatedAssemblyWorkers   Int?
  estimatedDemolitionWorkers Int?
  plusCode                   String?
  postalCode                 String?
  prefecture                 String?
  scaffoldingSpec            Json?
  materialCost               Decimal?                         @db.Decimal(12, 2)
  otherExpenses              Decimal?                         @db.Decimal(12, 2)
  loadingCost                Decimal?                         @db.Decimal(12, 2)
  revenueOverride            Int?
  customerShortName          String?
  latitude                   Float?
  longitude                  Float?
  constructionSuffixId       String?
  honorific                  String?
  name                       String?
  siteShortName              String?
  scheduledStartDate         DateTime?
  scheduledEndDate           DateTime?
  managerIds                 String[]                         @default([])
  roadPermitCompletionDate   DateTime?
  roadPermitReceiveDate      DateTime?
  roadPermitExpiryDate       DateTime?
  assignments                ProjectAssignment[]
  calendarEvents             CalendarEvent[]
  files                      ProjectMasterFile[]
  projectMaterialItems       ProjectMaterialItem[]
  subcontractorCosts         ProjectMasterSubcontractorCost[]
  siteSurveys                SiteSurvey[]

  @@index([title])
  @@index([customerId])
  @@index([customerName])
  @@index([status])
  @@index([createdAt])
  @@index([customerId], map: "idx_project_master_customer")
  @@index([title], map: "idx_project_master_title")
  @@schema("public")
}

model ProjectAssignment {
  id                        String                @id @default(uuid())
  projectMasterId           String
  assignedEmployeeId        String
  date                      DateTime
  memberCount               Int                   @default(0)
  workers                   String?
  vehicles                  String?
  meetingTime               String?
  sortOrder                 Int                   @default(0)
  remarks                   String?
  confirmedWorkerIds        String?
  confirmedVehicleIds       String?
  isDispatchConfirmed       Boolean               @default(false)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  updatedBy                 String?
  constructionType          String?
  estimatedHours            Float                 @default(8.0)
  dispatchRemark            String?
  workStartedAt             DateTime?
  workEndedAt               DateTime?
  workStartedComment        String?
  workEndedComment          String?
  laborCostOverride         Int?
  vehicleCostOverride       Int?
  subcontractorCostOverride Int?
  assignmentVehicles        AssignmentVehicle[]
  assignmentWorkers         AssignmentWorker[]
  dailyReportWorkItems      DailyReportWorkItem[]
  scheduleChangeHistories   ScheduleChangeHistory[]
  workReportReplies         WorkReportReply[]
  projectMaster             ProjectMaster         @relation(fields: [projectMasterId], references: [id], onDelete: Cascade)

  @@index([projectMasterId])
  @@index([assignedEmployeeId])
  @@index([date])
  @@index([isDispatchConfirmed])
  @@index([constructionType])
  @@index([date], map: "idx_assignment_date")
  @@index([assignedEmployeeId, date], map: "idx_assignment_employee_date")
  @@index([projectMasterId], map: "idx_assignment_project_master")
  @@schema("public")
}

model ScheduleChangeHistory {
  id            String            @id @default(uuid())
  assignmentId  String
  changedById   String
  changedAt     DateTime          @default(now())
  changeType    String
  previousValue String
  newValue      String
  assignment    ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([changedAt])
  @@index([assignmentId])
  @@index([changedById])
  @@schema("public")
}

model AssignmentWorker {
  id           String            @id @default(uuid())
  assignmentId String
  workerId     String?
  workerName   String
  assignment   ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([workerName])
  @@index([workerId])
  @@schema("public")
}

model AssignmentVehicle {
  id           String            @id @default(uuid())
  assignmentId String
  vehicleId    String?
  vehicleName  String
  assignment   ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([vehicleName])
  @@schema("public")
}

model Customer {
  id             String   @id @default(uuid())
  name           String
  shortName      String?
  contactPersons String?
  email          String?
  phone          String?
  fax            String?
  postalCode     String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      String?
  honorific      String   @default("御中")

  @@index([name])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([name], map: "idx_customer_name")
  @@schema("public")
}

model Estimate {
  id                 String   @id @default(uuid())
  estimateNumber     String   @unique
  title              String
  items              String
  subtotal           Decimal  @db.Decimal(12, 2)
  tax                Decimal  @db.Decimal(12, 2)
  total              Decimal  @db.Decimal(12, 2)
  validUntil         DateTime
  status             String   @default("draft")
  notes              String?
  location           String?
  costTotal          Int?
  constructionPeriod String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  updatedBy          String?
  createdById        String?
  createdByName      String?
  projectMasterId    String?
  customerId         String?

  @@index([estimateNumber])
  @@index([customerId])
  @@index([projectMasterId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdAt(sort: Desc)], map: "idx_estimate_created")
  @@index([status], map: "idx_estimate_status")
  @@schema("public")
}

model Invoice {
  id              String    @id @default(uuid())
  estimateId      String?
  invoiceNumber   String    @unique
  title           String
  items           String
  subtotal        Decimal   @db.Decimal(12, 2)
  tax             Decimal   @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  dueDate         DateTime
  status          String    @default("draft")
  paidDate        DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedBy       String?
  projectMasterId String?
  customerId      String?

  @@index([invoiceNumber])
  @@index([projectMasterId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@schema("public")
}

model InvoiceProjectMaster {
  id              String @id @default(uuid())
  invoiceId       String
  projectMasterId String
  sortOrder       Int    @default(0)

  @@unique([invoiceId, projectMasterId])
  @@index([invoiceId])
  @@index([projectMasterId])
  @@schema("public")
}

model EstimateVersion {
  id                 String   @id @default(uuid())
  estimateId         String
  versionNumber      Int
  estimateNumber     String
  title              String
  items              String
  subtotal           Decimal  @db.Decimal(12, 2)
  tax                Decimal  @db.Decimal(12, 2)
  total              Decimal  @db.Decimal(12, 2)
  validUntil         DateTime
  status             String
  notes              String?
  location           String?
  costTotal          Int?
  constructionPeriod String?
  projectMasterId    String?
  customerId         String?
  createdAt          DateTime @default(now())
  createdBy          String?

  @@unique([estimateId, versionNumber])
  @@index([estimateId, versionNumber(sort: Desc)])
  @@schema("public")
}

model InvoiceVersion {
  id                   String    @id @default(uuid())
  invoiceId            String
  versionNumber        Int
  invoiceNumber        String
  title                String
  items                String
  subtotal             Decimal   @db.Decimal(12, 2)
  tax                  Decimal   @db.Decimal(12, 2)
  total                Decimal   @db.Decimal(12, 2)
  dueDate              DateTime
  status               String
  paidDate             DateTime?
  notes                String?
  estimateId           String?
  projectMasterId      String?
  customerId           String?
  projectMasterIdsJson String    @default("[]")
  createdAt            DateTime  @default(now())
  createdBy            String?

  @@unique([invoiceId, versionNumber])
  @@index([invoiceId, versionNumber(sort: Desc)])
  @@schema("public")
}

model BillingTitle {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  quantity  Float?
  unit      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([sortOrder])
  @@schema("public")
}

model InvoiceTitleSuggestion {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([sortOrder])
  @@schema("public")
}

model Vehicle {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dailyRate Decimal? @db.Decimal(10, 2)

  @@index([name])
  @@schema("public")
}

model Worker {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dailyRate Decimal?

  @@index([name])
  @@schema("public")
}

model ConstructionContent {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([sortOrder])
  @@schema("public")
}

model ConstructionSuffix {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([sortOrder])
  @@schema("public")
}

model ScaffoldingSpecGroup {
  id        String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  sortOrder Int                   @default(0)
  isActive  Boolean               @default(true)
  items     ScaffoldingSpecItem[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @default(now()) @updatedAt

  @@index([sortOrder])
  @@schema("public")
}

model ScaffoldingSpecItem {
  id        String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  groupId   String
  group     ScaffoldingSpecGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  type      String               @default("toggle") // 'toggle' | 'segment' | 'text'
  options   Json? // segment用 string[]
  hasText   Boolean              @default(false) // toggle/segment時に補足テキスト欄を併設するか
  legacyKey String? // 旧固定フィールドのキー（後方互換）
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt

  @@index([groupId])
  @@index([sortOrder])
  @@schema("public")
}

model ConstructionType {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  color     String   @default("#a8c8e8")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  subcontractorCosts ProjectMasterSubcontractorCost[]

  @@index([name])
  @@index([sortOrder])
  @@schema("public")
}

model ProjectMasterSubcontractorCost {
  id                 String           @id @default(uuid())
  projectMasterId    String
  constructionTypeId String
  amount             Decimal          @db.Decimal(12, 2)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  projectMaster      ProjectMaster    @relation(fields: [projectMasterId], references: [id], onDelete: Cascade)
  constructionType   ConstructionType @relation(fields: [constructionTypeId], references: [id], onDelete: Restrict)

  @@unique([projectMasterId, constructionTypeId])
  @@index([projectMasterId])
  @@index([constructionTypeId])
  @@schema("public")
}

model PartnerWorkVolume {
  id                  String    @id @default(uuid())
  partnerCompanyId    String
  date                DateTime  @db.Date
  customerName        String?
  projectMasterId     String?
  projectTitle        String
  managerName         String?
  constructionContent String?
  amount              Int       @default(0)
  sourceAssignmentId  String?   @unique
  isManual            Boolean   @default(false)
  sortOrder           Int       @default(0)
  notes               String?
  status              String    @default("draft")
  completedAt         DateTime?
  completedBy         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  updatedBy           String?

  @@index([partnerCompanyId, date])
  @@index([date])
  @@index([partnerCompanyId, status])
  @@schema("public")
}

model PartnerWorkVolumeMonth {
  id               String    @id @default(uuid())
  partnerCompanyId String
  year             Int
  month            Int
  status           String    @default("draft")
  completedAt      DateTime?
  completedBy      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([partnerCompanyId, year, month])
  @@index([partnerCompanyId])
  @@schema("public")
}

model SystemSettings {
  id                          String   @id @default("default")
  totalMembers                Int      @default(20)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  laborDailyRate              Decimal  @default(18000) @db.Decimal(10, 2)
  standardWorkMinutes         Int      @default(480)
  displayedForemanIds         String   @default("[]")
  subcontractorRevenueRate    Int      @default(60)
  subcontractorAssemblyRate   Int      @default(60)
  subcontractorDemolitionRate Int      @default(40)

  @@schema("public")
}

model MemberCountHistory {
  id        String   @id @default(uuid())
  startDate DateTime @db.Date
  count     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startDate])
  @@index([startDate])
  @@schema("public")
}

model UnitPriceTemplate {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@schema("public")
}

model UnitPriceCategory {
  id               String            @id @default(uuid())
  name             String
  quantity         Float?
  unit             String?
  sortOrder        Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  unitPriceMasters UnitPriceMaster[]

  @@index([sortOrder])
  @@schema("public")
}

model UnitPriceMaster {
  id             String                   @id @default(uuid())
  description    String
  unit           String
  quantity       Float?
  unitPrice      Decimal                  @db.Decimal(12, 2)
  templates      String
  categoryId     String?
  category       UnitPriceCategory?       @relation(fields: [categoryId], references: [id])
  notes          String?
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  specifications UnitPriceSpecification[]

  @@index([description])
  @@index([categoryId])
  @@schema("public")
}

model UnitPriceSpecification {
  id                String          @id @default(uuid())
  unitPriceMasterId String
  unitPriceMaster   UnitPriceMaster @relation(fields: [unitPriceMasterId], references: [id])
  name              String
  sortOrder         Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([unitPriceMasterId])
  @@index([sortOrder])
  @@schema("public")
}

model CostMaster {
  id        String   @id @default(uuid())
  name      String
  quantity  Float?
  unit      String?
  unitPrice Decimal? @db.Decimal(12, 2)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([sortOrder])
  @@schema("public")
}

model CompanyInfo {
  id                  String   @id @default("default")
  name                String
  postalCode          String
  address             String
  tel                 String
  fax                 String?
  email               String?
  representative      String
  sealImage           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  licenseNumber       String?
  registrationNumber  String?
  bankAccounts        Json?
  representativeTitle String?
  logoImage           String?
  contactPerson       String?

  @@schema("public")
}

model CalendarRemark {
  id        String   @id @default(uuid())
  dateKey   String   @unique
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dateKey])
  @@schema("public")
}

model CellRemark {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  foremanId String
  dateKey   String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([foremanId, dateKey])
  @@index([foremanId])
  @@index([dateKey])
  @@schema("public")
}

model MemberAdjustment {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  dateKey    String   @unique
  adjustment Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dateKey])
  @@schema("public")
}

model VacationRecord {
  id          String   @id @default(uuid())
  dateKey     String   @unique
  employeeIds String
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dateKey])
  @@schema("public")
}

model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  displayedForemanIds String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@schema("public")
}

model DailyReport {
  id                    String                @id @default(uuid())
  foremanId             String
  date                  DateTime
  morningLoadingMinutes Int                   @default(0)
  eveningLoadingMinutes Int                   @default(0)
  earlyStartMinutes     Int                   @default(0)
  overtimeMinutes       Int                   @default(0)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  updatedBy             String?
  breakMinutes          Int                   @default(0)
  workItems             DailyReportWorkItem[]

  @@unique([foremanId, date])
  @@index([foremanId])
  @@index([date])
  @@schema("public")
}

model DailyReportWorkItem {
  id            String            @id @default(uuid())
  dailyReportId String
  assignmentId  String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  startTime     String?
  endTime       String?
  breakMinutes  Int               @default(0)
  workerIds     String[]          @default([])
  assignment    ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  dailyReport   DailyReport       @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  @@index([dailyReportId])
  @@index([assignmentId])
  @@schema("public")
}

// 出勤簿（分数+早終時刻ベース）
// 定時 8:00-17:00、職長が代表入力
model AttendanceRecord {
  id                    String   @id @default(uuid())
  userId                String // 出勤者のユーザーID
  date                  DateTime @db.Date
  foremanId             String // 入力した職長のユーザーID
  status                String   @default("present") // present|absent|paid_leave|holiday （管理者が後で調整）
  earlyStartMinutes     Int      @default(0) // 早出（分）
  morningLoadingMinutes Int      @default(0) // 朝積（分）
  overtimeMinutes       Int      @default(0) // 残業（分）
  eveningLoadingMinutes Int      @default(0) // 夕積（分）
  earlyEndTime          String? // 早終時刻 "16:30" 形式 / null=早終なし
  note                  String?
  createdBy             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
  @@index([foremanId])
  @@index([foremanId, date])
  @@schema("public")
}

// 作図機能用。次タスクで prisma migrate dev によりテーブル作成予定。
// それまではこのモデルを参照する API・コードを書かないこと。
model SiteSurvey {
  id              String    @id @default(uuid())
  projectMasterId String?
  title           String
  customerName    String?
  workType        String?
  managerIds      String[]  @default([])
  scheduledDate   DateTime?
  notes           String?
  handoffNotes    String?
  arrivalTime     String?
  vehicleSpec     String?
  drawingData     Json
  scaffoldSpec    Json?
  surroundings    Json?
  perimeter       Float?
  floorArea       Float?
  scaffoldArea    Float?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedBy       String?

  projectMaster ProjectMaster? @relation(fields: [projectMasterId], references: [id], onDelete: SetNull)

  @@index([projectMasterId])
  @@index([createdAt])
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log_entries {
  instance_id String?   @db.Uuid
  id          String    @id @db.Uuid
  payload     Json?     @db.Json
  created_at  DateTime? @db.Timestamptz(6)
  ip_address  String    @default("") @db.VarChar(64)

  @@index([instance_id], map: "audit_logs_instance_id_idx")
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model flow_state {
  id                     String                 @id @db.Uuid
  user_id                String?                @db.Uuid
  auth_code              String?
  code_challenge_method  code_challenge_method?
  code_challenge         String?
  provider_type          String
  provider_access_token  String?
  provider_refresh_token String?
  created_at             DateTime?              @db.Timestamptz(6)
  updated_at             DateTime?              @db.Timestamptz(6)
  authentication_method  String
  auth_code_issued_at    DateTime?              @db.Timestamptz(6)
  invite_token           String?
  referrer               String?
  oauth_client_state_id  String?                @db.Uuid
  linking_target_id      String?                @db.Uuid
  email_optional         Boolean                @default(false)
  saml_relay_states      saml_relay_states[]

  @@index([created_at(sort: Desc)])
  @@index([auth_code], map: "idx_auth_code")
  @@index([user_id, authentication_method], map: "idx_user_id_auth_method")
  @@schema("auth")
