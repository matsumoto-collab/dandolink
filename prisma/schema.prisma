}

model MaterialRequisition {
  id              String                    @id @default(uuid())
  projectMasterId String
  date            DateTime
  foremanId       String
  foremanName     String                    @default("")
  type            String                    @default("出庫")
  status          String                    @default("draft")
  vehicleInfo     String?
  notes           String?
  createdBy       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  items           MaterialRequisitionItem[]

  @@index([projectMasterId])
  @@index([date])
  @@index([foremanId])
  @@index([status])
  @@schema("public")
}

model MaterialRequisitionItem {
  id             String              @id @default(uuid())
  requisitionId  String
  materialItemId String
  quantity       Int                 @default(0)
  vehicleLabel   String?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  requisition    MaterialRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  materialItem   MaterialItem        @relation(fields: [materialItemId], references: [id])

  @@index([requisitionId])
  @@index([materialItemId])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Manager {
  id        String   @id
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([name])
  @@schema("public")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@schema("public")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    @default("general")
  title     String
  body      String
  url       String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@schema("public")
}

/// 個人ごとの通知設定。
/// 設定が無いユーザー = enabled=true, scope='all' とみなす（既存ユーザーの挙動を維持）。
/// scope='mine' は ProjectMaster.managerIds に自分が含まれる案件の通知のみ受信。
/// chat-message / dispatch-confirmed など projectMasterId に紐付かない種別では scope は無視される。
model UserNotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  type      String
  enabled   Boolean  @default(true)
  scope     String   @default("all")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@schema("public")
}

/// 作業開始/完了メモへの返信スレッド。
/// (assignmentId, reportType) 単位で複数返信がぶら下がる。
/// reportType: "start" = 開始メモへの返信 / "end" = 完了メモへの返信
/// 削除は投稿者本人または admin/manager のみ。編集機能は無い。
model WorkReportReply {
  id           String   @id @default(uuid())
  assignmentId String
  reportType   String
  authorId     String
  body         String
  createdAt    DateTime @default(now())

  assignment   ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, reportType])
  @@index([authorId])
  @@schema("public")
}

/// 車両引き継ぎ通知の差分管理表 (協力業者車両_閲覧権限と引き継ぎ通知_実装指示.md §4-3)
/// 「いまあるべき引き継ぎ集合」と既存の有効レコードを差分し、追加(送信)/削除(取消通知)を整合させる。
/// canceledAt = null が「有効」、非 null が「取り消し済み」。
model VehicleHandoverNotice {
  id               String    @id @default(cuid())
  vehicleId        String
  fromAssignmentId String
  toAssignmentId   String
  notifiedUserIds  String
  sentAt           DateTime  @default(now())
  canceledAt       DateTime?

  @@index([vehicleId, canceledAt])
  @@index([fromAssignmentId])
  @@index([toAssignmentId])
  @@schema("public")
}

/// マイカレンダー (admin / manager 限定)
/// 現調・打ち合わせ・道路使用許可関連の予定を管理する。
/// visibility: 'private' = 作成者のみ閲覧 / 'shared' = admin/manager 全員に共有
/// category: site_survey | meeting | road_permit_complete | road_permit_receive | road_permit_expiry | other
model CalendarEvent {
  id              String         @id @default(uuid())
  title           String
  description     String?
  category        String         @default("other")
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean        @default(false)
  location        String?
  visibility      String         @default("shared")
  color           String?
  createdBy       String
  projectMasterId String?
  customerId      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  updatedBy       String?
  projectMaster   ProjectMaster? @relation(fields: [projectMasterId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([createdBy])
  @@index([projectMasterId])
  @@index([category])
  @@index([visibility, startAt])
  @@schema("public")
}

model ChatRoom {
  id                 String    @id @default(uuid())
  type               String // 'dm' | 'group' | 'project'
  name               String?
  projectMasterId    String?
  createdBy          String
  lastMessageAt      DateTime?
  lastMessagePreview String?
  isArchived         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  members  ChatMember[]
  messages Message[]

  @@index([projectMasterId])
  @@index([type])
  @@index([lastMessageAt(sort: Desc)])
  @@schema("public")
}

model ChatMember {
  id                String    @id @default(uuid())
  roomId            String
  userId            String
  role              String    @default("member") // 'owner' | 'member'
  joinedAt          DateTime  @default(now())
  lastReadAt        DateTime?
  lastReadMessageId String?
  isMuted           Boolean   @default(false)
  isPinned          Boolean   @default(false)
  leftAt            DateTime?

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, lastReadAt])
  @@schema("public")
}

model Message {
  id          String    @id @default(uuid())
  roomId      String
  senderId    String
  body        String
  contentType String    @default("text") // 'text' | 'image' | 'pdf' | 'system'
  parentId    String?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  room        ChatRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]
  mentions    MessageMention[]
  reads       MessageRead[]

  @@index([roomId, createdAt(sort: Desc)])
  @@index([senderId])
  @@schema("public")
}

model MessageAttachment {
  id                          String    @id @default(uuid())
  messageId                   String
  fileType                    String // 'image' | 'pdf'
  storagePath                 String
  thumbnailPath               String?
  signedUrl                   String?
  signedUrlExpiresAt          DateTime?
  thumbnailSignedUrl          String?
  thumbnailSignedUrlExpiresAt DateTime?
  mimeType                    String
  fileSize                    Int
  width                       Int?
  height                      Int?
  createdAt                   DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@schema("public")
}

model MessageMention {
  id         String   @id @default(uuid())
  messageId  String
  targetType String // 'user' | 'project' | 'role'
  targetId   String // userId / projectMasterId / 'admin' or 'admin,manager'
  label      String? // 表示名（@山田太郎の "山田太郎"）。古いレコードは null
  createdAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([targetType, targetId])
  @@schema("public")
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@schema("public")
}

// 振込先マスター（取引先の銀行口座台帳）
model Payee {
  id            String   @id @default(uuid())
  name          String // 入金先名（例：㈱開成工業）
  nameKana      String? // フリガナ（カ）オーケーグランデなど
  alias         String? // 略称・別名
  feeBearer     String   @default("them") // 手数料負担: "us"=当社負担(●), "them"=先方負担
  bankName      String? // 銀行名（例：愛媛銀行）
  branchName    String? // 支店名（例：見奈良支店）
  accountType   String? // 口座種別: "普通" | "当座"
  accountNumber String? // 口座番号
  accountHolder String? // 口座名義（カナ）
  notes         String? // 備考
  isActive      Boolean  @default(true) // 利用中かどうか
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     String?

  paymentSchedules PaymentSchedule[]

  @@index([name])
  @@index([isActive])
  @@schema("public")
}

// 支払予定（毎月の支払スケジュール）
model PaymentSchedule {
  id            String    @id @default(uuid())
  paymentDate   DateTime // 支払日（4月10日、4月末など）
  paymentType   String    @default("transfer") // "transfer"=銀行振込, "payment_slip"=払込用紙
  payeeId       String? // 振込先マスターへの参照（マスターから選択した場合）
  payeeName     String // 入金先名（スナップショット保持。マスター変更後も予定は変わらない）
  amount        Decimal   @db.Decimal(12, 2) // 金額
  feeFlag       Boolean   @default(false) // 当社が手数料を負担するか（Excelの●に相当）
  dueDate       DateTime? // 振込期日（払込用紙の場合）
  bankName      String? // 銀行名（スナップショット）
  branchName    String? // 支店名
  accountType   String? // 口座種別
  accountNumber String? // 口座番号
  accountHolder String? // 口座名義（カナ等）
  isPaid        Boolean   @default(false) // 支払済みフラグ
  paidAt        DateTime? // 支払完了日時
  paidBy        String? // 支払処理した人
  notes         String? // 備考
  sortOrder     Int       @default(0) // 同じ支払日内の表示順
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  updatedBy     String?

  payee Payee? @relation(fields: [payeeId], references: [id], onDelete: SetNull)

  @@index([paymentDate])
  @@index([payeeId])
  @@index([paymentType])
  @@index([isPaid])
  @@index([paymentDate, paymentType])
  @@schema("public")
}

enum aal_level {
  aal1
  aal2
  aal3

  @@schema("auth")
}

enum code_challenge_method {
  s256
  plain

  @@schema("auth")
}

enum factor_status {
  unverified
  verified

  @@schema("auth")
}

enum factor_type {
  totp
  webauthn
  phone

  @@schema("auth")
}

enum oauth_authorization_status {
  pending
  approved
  denied
  expired

  @@schema("auth")
}

enum oauth_client_type {
  public
  confidential

  @@schema("auth")
}

enum oauth_registration_type {
  dynamic
  manual

  @@schema("auth")
}

enum oauth_response_type {
  code

  @@schema("auth")
}

enum one_time_token_type {
  confirmation_token
  reauthentication_token
  recovery_token
  email_change_token_new
  email_change_token_current
  phone_change_token

  @@schema("auth")
}
