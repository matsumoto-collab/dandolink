model MaterialCategory {
  id        String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt
  items     MaterialItem[]

  @@index([name])
  @@index([sortOrder])
  @@schema("public")
}

model MaterialItem {
  id                    String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  categoryId            String
  name                  String
  spec                  String?
  unit                  String                    @default("本")
  sortOrder             Int                       @default(0)
  isActive              Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @default(now()) @updatedAt
  category              MaterialCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stockQuantity         Int                       @default(0)
  // ネット / シート / リース品など notes-JSON が出庫の正となる品目を
  // Phase 3 の倉庫在庫自動減算対象から外すための構造フラグ（catalog.ts と同期）
  excludeFromStockDecrement Boolean               @default(false)
  requisitionItems      MaterialRequisitionItem[]
  inventoryTransactions InventoryTransaction[]
  projectMaterialItems  ProjectMaterialItem[]

  @@index([categoryId])
  @@index([sortOrder])
  @@schema("public")
}

model InventoryTransaction {
  id             String       @id @default(uuid())
  materialItemId String
  quantity       Int
  type           String
  referenceId    String?
  referenceType  String?
  notes          String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  // C10（#4 解消 / 冪等を DB 制約で強制）:
  //   「同一適用世代」を一意に識別する決定論的キー。
  //   形式 = `<referenceId>:<materialItemId>:<direction>:<generation>`
  //   （direction = forward|reversal、generation = 当該 referenceId+item の
  //    forward/reversal サイクル数を既存台帳から決定論的に算出した世代番号）。
  //   並行重複 INSERT は同一 generation → 同一キー → 部分 unique 違反で
  //   2 本目以降が DB レベルで拒否される（アプリ層 read-then-write の
  //   TOCTOU を構造的に排除）。
  //   逆仕訳後の正当な再 forward は generation が進み別キーになるため許容。
  //   棚卸し調整など台帳外 Tx は null（部分 unique の対象外）。
  idempotencyKey String?
  materialItem   MaterialItem @relation(fields: [materialItemId], references: [id])

  @@index([materialItemId])
  @@index([createdAt])
  @@schema("public")
}

model ProjectMaterialItem {
  id               String        @id @default(uuid())
  projectMasterId  String
  materialItemId   String
  requiredQuantity Int           @default(0)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  projectMaster    ProjectMaster @relation(fields: [projectMasterId], references: [id], onDelete: Cascade)
  materialItem     MaterialItem  @relation(fields: [materialItemId], references: [id])

  @@unique([projectMasterId, materialItemId])
  @@index([projectMasterId])
  @@schema("public")
}

