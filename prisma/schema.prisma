generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

model User {
  id                      String   @id @default(cuid())
  username                String   @unique
  email                   String   @unique
  displayName             String
  passwordHash            String
  role                    String   @default("manager")
  assignedProjects        String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  teamId                  String?
  dailyRate               Decimal? @db.Decimal(10, 2)
  dispatchSortOrder       Int?
  hideByDefaultInDispatch Boolean  @default(false)
  companyId               String?
  isLoginEnabled          Boolean  @default(true)
  failedLoginCount        Int      @default(0)
  lockedUntil             DateTime?
  // role='PARTNER' のときに利用。'exclusive' = 税別請求、'inclusive' = 税込請求。
  // 出来高表のフッター計算と PDF 表示の分岐に使う。
  partnerTaxMode          String   @default("exclusive")
  // 現金出納帳へのアクセス許可（個別ユーザー指定）。admin ロールでも false なら不可。
  canAccessCashbook       Boolean  @default(false)
  // 仮予定の「先方確認予定日」自動提案のリード日数（予定日の◯日前）。担当者ごとに感覚が違うため個別に持つ。
  tentativeConfirmLeadDays Int     @default(14)
  company                 User?    @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: SetNull)
  members                 User[]   @relation("CompanyMembers")
  billingDrafts           BillingDraft[]
  safetyProfile           WorkerSafetyProfile?

  @@index([username])
  @@index([email])
  @@index([teamId])
  @@index([role])
  @@index([companyId])
  @@schema("public")
}

model ProjectMaster {
  id                         String                           @id @default(uuid())
  title                      String
  constructionType           String                           @default("other")
  status                     String                           @default("active")
  location                   String?
  description                String?
  remarks                    String?
  createdBy                  String?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  updatedBy                  String?
  area                       Float?
  areaRemarks                String?
  city                       String?
  constructionContent        String?
  contractAmount             Int?
  customerId                 String?
  customerName               String?
  estimatedAssemblyWorkers   Int?
  estimatedDemolitionWorkers Int?
  plusCode                   String?
  postalCode                 String?
  prefecture                 String?
  scaffoldingSpec            Json?
  materialCost               Decimal?                         @db.Decimal(12, 2)
  otherExpenses              Decimal?                         @db.Decimal(12, 2)
  loadingCost                Decimal?                         @db.Decimal(12, 2)
  subcontractorExpense       Decimal?                         @db.Decimal(12, 2)
  manualCostItems            Json?
  revenueOverride            Int?
  customerShortName          String?
  latitude                   Float?
  longitude                  Float?
  constructionSuffixId       String?
  honorific                  String?
  name                       String?
  siteShortName              String?
  scheduledStartDate         DateTime?
  scheduledEndDate           DateTime?
  managerIds                 String[]                         @default([])
  roadPermitCompletionDate   DateTime?
  roadPermitReceiveDate      DateTime?
  roadPermitExpiryDate       DateTime?
  billingDecision            String                           @default("pending")
  billingDecisionBy          String?
  billingDecisionAt          DateTime?
  billingStatusOverride      String?
  assignments                ProjectAssignment[]
  calendarEvents             CalendarEvent[]
  files                      ProjectMasterFile[]
  projectMaterialItems       ProjectMaterialItem[]
  subcontractorCosts         ProjectMasterSubcontractorCost[]
  siteSurveys                SiteSurvey[]
  billingDrafts              BillingDraft[]
  safetyDocuments            SafetyDocument[]
  purchaseInvoices           PurchaseInvoice[]
  purchaseInvoiceAllocations PurchaseInvoiceAllocation[]
  receipts                   Receipt[]

  @@index([title])
  @@index([customerId])
  @@index([customerName])
  @@index([status])
  @@index([createdAt])
  @@index([billingDecision])
  @@index([customerId], map: "idx_project_master_customer")
  @@index([title], map: "idx_project_master_title")
  @@schema("public")
}

/// 請求判断ボードの「案件 × 締め基準月(periodKey=YYYY-MM)」ごとの請求判断。
/// 'pending'(判断待ち) は行を作らない＝レコード無しで表現し、月をまたいで判断が貼り付かないようにする。
/// projectMasterId は ProjectMaster.id（FK は張らない＝集計専用の軽量テーブル。MonthlyProjectCostOverride に倣う）。
model ProjectBillingDecision {
  id              String    @id @default(uuid())
  projectMasterId String
  periodKey       String // 締め基準月 "YYYY-MM"
  decision        String // 'hold' | 'excluded' | 'billed'（'pending' は行なし）
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([projectMasterId, periodKey])
  @@index([periodKey])
  @@schema("public")
}

model ProjectAssignment {
  id                        String                @id @default(uuid())
  projectMasterId           String
  assignedEmployeeId        String
  date                      DateTime
  memberCount               Int                   @default(0)
  workers                   String?
  vehicles                  String?
  meetingTime               String?
  sortOrder                 Int                   @default(0)
  remarks                   String?
  confirmedWorkerIds        String?
  confirmedVehicleIds       String?
  isDispatchConfirmed       Boolean               @default(false)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  updatedBy                 String?
  constructionType          String?
  estimatedHours            Float                 @default(8.0)
  dispatchRemark            String?
  workStartedAt             DateTime?
  workEndedAt               DateTime?
  workStartedComment        String?
  workEndedComment          String?
  laborCostOverride         Int?
  vehicleCostOverride       Int?
  subcontractorCostOverride Int?
  // 日付の確度。'confirmed'（確定・既定）| 'tentative'（仮＝先方未確定の仮押さえ）。
  // isDispatchConfirmed（社内手配の確定）とは別概念・直交。
  dateStatus                String                @default("confirmed")
  // 仮予定の「この日までに先方へ確認する」目安日（JST 0時規約）。tentative のときのみ意味を持つ。
  confirmDueDate            DateTime?
  assignmentVehicles        AssignmentVehicle[]
  assignmentWorkers         AssignmentWorker[]
  dailyReportWorkItems      DailyReportWorkItem[]
  scheduleChangeHistories   ScheduleChangeHistory[]
  workReportReplies         WorkReportReply[]
  projectMaster             ProjectMaster         @relation(fields: [projectMasterId], references: [id], onDelete: Cascade)

  @@index([projectMasterId])
  @@index([assignedEmployeeId])
  @@index([date])
  @@index([isDispatchConfirmed])
  @@index([constructionType])
  @@index([date], map: "idx_assignment_date")
  @@index([assignedEmployeeId, date], map: "idx_assignment_employee_date")
  @@index([projectMasterId], map: "idx_assignment_project_master")
  @@schema("public")
}

model ScheduleChangeHistory {
  id            String            @id @default(uuid())
  assignmentId  String
  changedById   String
  changedAt     DateTime          @default(now())
  changeType    String
  previousValue String
  newValue      String
  assignment    ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([changedAt])
  @@index([assignmentId])
  @@index([changedById])
  @@schema("public")
}

// 配置の物理削除を「元に戻す」ためのスナップショット控え。
// 削除時に配置の全項目を JSON(snapshot) に退避し、復元時は新規配置として再作成する。
// ProjectAssignment への FK は張らない（配置が消えてもこの行は残す＝カスケードで消えないため）。
model DeletedAssignmentLog {
  id              String    @id @default(uuid())
  assignmentId    String
  projectMasterId String
  snapshot        String
  deletedById     String
  deletedAt       DateTime  @default(now())
  restoredAt      DateTime?
  restoredById    String?

  @@index([deletedAt])
  @@index([projectMasterId])
  @@schema("public")
}

model AssignmentWorker {
  id           String            @id @default(uuid())
  assignmentId String
  workerId     String?
  workerName   String
  assignment   ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([workerName])
  @@index([workerId])
  @@schema("public")
}

model AssignmentVehicle {
  id           String            @id @default(uuid())
  assignmentId String
  vehicleId    String?
  vehicleName  String
  assignment   ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([vehicleName])
  @@schema("public")
}

model Customer {
  id             String   @id @default(uuid())
  name           String
  shortName      String?
  contactPersons String?
  email          String?
  phone          String?
  fax            String?
  postalCode     String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      String?
  honorific      String   @default("御中")
  closingDay     Int      @default(0) // 請求の締め日。0=末締め、それ以外は締め日(5/10/15/20/25)
  billingDrafts  BillingDraft[]

  @@index([name])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([name], map: "idx_customer_name")
  @@schema("public")
}

// LINE公式アカウントと顧客担当者(Customer.contactPersons[].id)をひも付けるための一時連携コード。
// 担当者ごとに発行 → 顧客が友だち追加後にトークでコードを送信 → Webhookが照合し lineUserId を確定する。
model LineLinkToken {
  id         String    @id @default(uuid())
  code       String    @unique
  customerId String
  contactId  String
  status     String    @default("pending") // pending | linked | expired
  lineUserId String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  linkedAt   DateTime?

  @@index([customerId])
  @@index([status])
  @@schema("public")
}

// 顧客への完了連絡（LINE等）の送信履歴。二重送信防止・「送信済み」表示・監査に使う（Phase2で書き込み）。
model CustomerNotificationLog {
  id              String   @id @default(uuid())
  assignmentId    String
  projectMasterId String?
  customerId      String?
  contactId       String?
  channel         String   @default("line") // line | email | sms
  milestone       String? // assembly | demolition
  lineUserId      String?
  messageText     String?
  imageCount      Int      @default(0)
  status          String   @default("sent") // sent | failed
  errorText       String?
  sentBy          String?
  sentAt          DateTime @default(now())

  @@index([assignmentId])
  @@index([projectMasterId])
  @@schema("public")
}

model Estimate {
  id                 String   @id @default(uuid())
  estimateNumber     String   @unique
  title              String
  items              String
  subtotal           Decimal  @db.Decimal(12, 2)
  tax                Decimal  @db.Decimal(12, 2)
  total              Decimal  @db.Decimal(12, 2)
  validUntil         DateTime
  status             String   @default("draft")
  notes              String?
  location           String?
  costTotal          Int?
  constructionPeriod String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  updatedBy          String?
  createdById        String?
  createdByName      String?
  projectMasterId    String?
  customerId         String?

  @@index([estimateNumber])
  @@index([customerId])
  @@index([projectMasterId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdAt(sort: Desc)], map: "idx_estimate_created")
  @@index([status], map: "idx_estimate_status")
  @@schema("public")
}

model Invoice {
  id              String    @id @default(uuid())
  estimateId      String?
  invoiceNumber   String    @unique
  title           String
  items           String
  subtotal        Decimal   @db.Decimal(12, 2)
  tax             Decimal   @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  dueDate         DateTime
  status          String    @default("draft")
  paidDate        DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedBy       String?
  projectMasterId String?
  customerId      String?
  billingDrafts   BillingDraft[]
  payments        InvoicePayment[]

  @@index([invoiceNumber])
  @@index([projectMasterId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@schema("public")
}

model InvoiceProjectMaster {
  id              String @id @default(uuid())
  invoiceId       String
  projectMasterId String
  sortOrder       Int    @default(0)

  @@unique([invoiceId, projectMasterId])
  @@index([invoiceId])
  @@index([projectMasterId])
  @@schema("public")
}

/// 請求書への入金記録。1請求書に複数回（分割入金）ぶら下がる。
/// 利益計算には影響させず「未収金の見える化」レイヤーとして使う（パターンA）。
/// 残額 = Invoice.total − Σ amount − Σ fee（fee=振込手数料の当社負担相殺分）。
model InvoicePayment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paidDate  DateTime // 入金日
  amount    Decimal  @db.Decimal(12, 2) // 入金額
  fee       Decimal  @default(0) @db.Decimal(12, 2) // 振込手数料（当社負担・相殺分）
  method    String? // 入金方法（振込/現金/相殺など）
  note      String? // 摘要
  createdAt DateTime @default(now())
  createdBy String?

  @@index([invoiceId])
  @@index([paidDate])
  @@schema("public")
}

model EstimateVersion {
  id                 String   @id @default(uuid())
  estimateId         String
  versionNumber      Int
  estimateNumber     String
  title              String
  items              String
  subtotal           Decimal  @db.Decimal(12, 2)
  tax                Decimal  @db.Decimal(12, 2)
  total              Decimal  @db.Decimal(12, 2)
  validUntil         DateTime
  status             String
  notes              String?
  location           String?
  costTotal          Int?
  constructionPeriod String?
  projectMasterId    String?
  customerId         String?
  createdAt          DateTime @default(now())
  createdBy          String?

  @@unique([estimateId, versionNumber])
  @@index([estimateId, versionNumber(sort: Desc)])
  @@schema("public")
}

model InvoiceVersion {
  id                   String    @id @default(uuid())
  invoiceId            String
  versionNumber        Int
  invoiceNumber        String
  title                String
  items                String
  subtotal             Decimal   @db.Decimal(12, 2)
  tax                  Decimal   @db.Decimal(12, 2)
  total                Decimal   @db.Decimal(12, 2)
  dueDate              DateTime
  status               String
  paidDate             DateTime?
  notes                String?
  estimateId           String?
  projectMasterId      String?
  customerId           String?
  projectMasterIdsJson String    @default("[]")
  createdAt            DateTime  @default(now())
  createdBy            String?

  @@unique([invoiceId, versionNumber])
  @@index([invoiceId, versionNumber(sort: Desc)])
  @@schema("public")
}

model BillingTitle {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  quantity  Float?
  unit      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([sortOrder])
  @@schema("public")
}

model InvoiceTitleSuggestion {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([sortOrder])
  @@schema("public")
}

model Vehicle {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dailyRate Decimal? @db.Decimal(10, 2)

  safetyProfile VehicleSafetyProfile?

  @@index([name])
  @@schema("public")
}

/// 【機能撤去済み 2026-07-03】安全書類（工事・通勤用車両届）用の車両安全プロフィール。Vehicle と1:1。
/// 安全書類機能のUI・APIは未使用のため削除済み。テーブルとデータは残置（復活時はモデル再利用）。
model VehicleSafetyProfile {
  id                 String    @id @default(uuid())
  vehicleId          String    @unique
  // ── 車両情報 ──
  vehicleType        String?   // 車種・型式（例: 2tダンプ / TRG-XZU605）
  registrationNumber String?   // 登録番号（車番。例: 名古屋 100 あ 12-34）
  usage              String?   // 用途: 工事用 / 通勤用 / 兼用
  inspectionExpiry   DateTime? // 車検満了日
  // ── 自賠責保険 ──
  jibaisekiCompany   String?
  jibaisekiExpiry    DateTime?
  // ── 任意保険 ──
  insuranceCompany   String?
  insuranceExpiry    DateTime?
  insurancePersonal  String?   // 対人賠償（例: 無制限）
  insuranceObjective String?   // 対物賠償（例: 無制限 / 1,000万円）
  insurancePassenger String?   // 搭乗者傷害
  // ── その他 ──
  defaultDriverName  String?   // 既定の運転者名（書類作成時に行ごとへ初期値として展開・上書き可）
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// 【機能撤去済み 2026-07-03】持込機械マスター（安全書類 Phase 2）。
/// 安全書類機能のUI・APIは未使用のため削除済み。テーブルとデータは残置（復活時はモデル再利用）。
model Machine {
  id                String    @id @default(uuid())
  name              String    // 機械名（例: 高所作業車 / 電動ハンマ）
  category          String    @default("general") // general / crane
  model             String?   // 型式
  serialNumber      String?   // 製造番号
  maker             String?   // メーカー
  capacity          String?   // 能力（吊上荷重・出力等）
  ownerName         String?   // 所有会社（リース元等）
  defaultOperatorName String? // 既定の取扱者・オペレーター名
  inspectionDate    DateTime? // 定期自主検査（特定自主検査）実施日
  inspectionExpiry  DateTime? // 検査証有効期限（クレーン等）
  certificateNumber String?   // 検査証番号（クレーン等）
  notes             String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([name])
  @@index([category])
  @@schema("public")
}

model Worker {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dailyRate Decimal?

  safetyProfile WorkerSafetyProfile?

  @@index([name])
  @@schema("public")
}

/// 【機能撤去済み 2026-07-03】安全書類（グリーンファイル）用の作業員安全プロフィール。
/// 安全書類機能のUI・APIは未使用のため削除済み。テーブルとデータは残置（復活時はモデル再利用）。
/// Worker（職方）または User のどちらか一方と 1:1（排他）。
/// DB側に CHECK (num_nonnulls("workerId","userId") = 1) を手動マイグレーションで付与済み
/// （@unique 2本だけでは両方NULLの行が複数作れるため）。
/// ⚠️ 法令上の禁止（健康保険法・国民年金法108条の4）: 健康保険の記号番号・基礎年金番号・
///    マイナンバーの列は追加してはならない。雇用保険は下4桁のみ可。
model WorkerSafetyProfile {
  id                       String    @id @default(uuid())
  workerId                 String?   @unique
  userId                   String?   @unique
  // ── 基本 ──
  furigana                 String?
  birthDate                DateTime?
  gender                   String?
  jobType                  String?
  attributes               String[]  @default([])
  hireDate                 DateTime?
  experienceYears          Int?
  workerCategory           String?
  // ── 連絡先 ──
  address                  String?
  tel                      String?
  familyContact            String?
  familyTel                String?
  // ── 健康 ──
  healthCheckDate          DateTime?
  bloodPressure            String?
  bloodType                String?
  specialHealthCheckDate   DateTime?
  specialHealthCheckType   String?
  // ── 保険・建退共 ──
  healthInsurance          String?
  pensionInsurance         String?
  employmentInsurance      String?
  employmentInsuranceLast4 String?
  rosaiSpecialInsurance    Boolean?
  kentaikyo                Boolean?
  chutaikyo                Boolean?
  kentaikyoTechou          Boolean?
  // ── その他 ──
  ccusId                   String?
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  worker         Worker?               @relation(fields: [workerId], references: [id], onDelete: Cascade)
  user           User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualifications WorkerQualification[]

  @@schema("public")
}

/// 【機能撤去済み 2026-07-03】安全プロフィールに紐づく資格・教育（1:N）。データ残置。
/// 資格証画像は Supabase Storage（project-master-files バケット）の
/// qualifications/{profileId}/ 配下に WebP＋サムネで保存し、署名URLは取得時に都度生成する。
model WorkerQualification {
  id             String    @id @default(uuid())
  profileId      String
  category       String    // special_education / skill_training / license
  name           String
  licenseNumber  String?   // 修了証・免許証の番号（健康保険番号等と異なり記載可の情報）
  acquiredAt     DateTime?
  expiresAt      DateTime?
  imagePath      String?   // 資格証画像の Storage パス
  imageThumbPath String?   // サムネイルの Storage パス
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile WorkerSafetyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@schema("public")
}

/// 【機能撤去済み 2026-07-03】安全書類本体（UI・API削除済み・データ残置）。data に生成時点のスナップショット（ヘッダー＋作業員＋並び順）をJSON保存し、
/// PDF再生成は常にスナップショットから行う（保存義務5年・再現性のため）。
/// 削除は deletedAt の論理削除のみ（物理削除機能は設けない）。
model SafetyDocument {
  id        String    @id @default(uuid())
  type      String    // Phase1: 'sagyoin_meibo'（作業員名簿）のみ
  projectId String?
  title     String
  data      Json
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projectMaster ProjectMaster? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@schema("public")
}

model ConstructionContent {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
